# --- CONFIGURACIÓN DE VOSTOK LABS ---
# Copia este archivo a .env y completa los datos de tus dashboards

# (Opcional) URL del servidor propio para sincronización de datos
# Los datos se guardan localmente por defecto.
VITE_SYNC_SERVER_URL=http://tu-servidor-propio.com

# Analytics & Buzón: Ahora procesados localmente vía IndexedDB.
# No se requieren llaves de terceros (Supabase/PostHog retirados).
