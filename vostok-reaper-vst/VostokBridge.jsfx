desc:Vostok Bridge (MASTER LINK)
// Vostok Labs - Universal Data Bridge
// Author: Vostok Labs Agent
// Version: 1.1.0

options:gmem=vostok_labs

@init
ext_noinit = 1;
FFT_SIZE = 1024;
fft_buffer = 0;
window_buffer = 2048;
pos = 0;

// Create Hann window
i = 0; loop(FFT_SIZE, window_buffer[i] = 0.5 * (1 - cos(2 * $pi * i / (FFT_SIZE - 1))); i += 1; );

@block
gmem[1000] += 1; // Constant Heartbeat (independent of audio)

@sample
s = (spl0 + spl1) * 0.5;
fft_buffer[pos*2] = s * window_buffer[pos];
fft_buffer[pos*2+1] = 0;
pos += 1;

pos >= FFT_SIZE ? (
  fft(fft_buffer, FFT_SIZE);
  permute_inplace(fft_buffer, FFT_SIZE);
  
  // HUD Spectrum Data (Bins 0-63)
  i = 0; loop(64,
    mag = sqrt(fft_buffer[i*2]^2 + fft_buffer[i*2+1]^2);
    gmem[i] = mag;
    i += 1;
  );
  
  // Pitch Detection Data
  max_mag = 0; max_bin = 0;
  i = 5; loop(500,
    m = sqrt(fft_buffer[i*2]^2 + fft_buffer[i*2+1]^2);
    m > max_mag ? ( max_mag = m; max_bin = i; );
    i += 1;
  );
  
  gmem[100] = max_bin * srate / FFT_SIZE; // Frequency
  gmem[101] = max_mag;                   // Peak Level
  
  pos = 0;
);
