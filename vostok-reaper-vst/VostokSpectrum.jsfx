desc:Vostok Spectrum (HD-RTA)
// Vostok Labs - Noir-Tech Audio Engineering
// Author: Vostok Labs Agent
// Version: 1.0.0

slider1:0<-100,12,1>Min dB
slider2:0<-100,12,1>Max dB
slider3:0.5<0,1,0.01>Smoothing

@init
ext_noinit = 1;
FFT_SIZE = 4096;
fft_buffer = 0;
window_buffer = 8192;
magnitudes = 16384;

// Create Hann window
i = 0;
loop(FFT_SIZE,
  window_buffer[i] = 0.5 * (1 - cos(2 * $pi * i / (FFT_SIZE - 1)));
  i += 1;
);

@sample
// Fill buffer for FFT
fft_buffer[pos*2] = (spl0 + spl1) * 0.5 * window_buffer[pos];
fft_buffer[pos*2+1] = 0;
pos += 1;

pos >= FFT_SIZE ? (
  fft(fft_buffer, FFT_SIZE);
  permute_inplace(fft_buffer, FFT_SIZE);
  
  i = 0;
  loop(FFT_SIZE / 2,
    re = fft_buffer[i*2];
    im = fft_buffer[i*2+1];
    mag = sqrt(re*re + im*im) / (FFT_SIZE / 2);
    db = 20 * log10(mag + 0.000000001);
    
    // Smoothing
    magnitudes[i] = magnitudes[i] * slider3 + db * (1 - slider3);
    i += 1;
  );
  pos = 0;
);

@gfx 800 400
// --- NOIR-TECH THEME ---
bg_r = 1/255; bg_g = 1/255; bg_b = 1/255;
gfx_set(bg_r, bg_g, bg_b, 1);
gfx_rect(0, 0, gfx_w, gfx_h);

// --- GRID ---
gfx_set(1, 1, 1, 0.05);
// Vertical log grid
f = 20;
loop(10,
  x = gfx_w * (log(f/20) / log(20000/20));
  gfx_line(x, 0, x, gfx_h);
  f *= 2.5; // Rough log steps
);
// Horizontal dB grid
y = 0;
loop(6,
  gfx_line(0, y, gfx_w, y);
  y += gfx_h / 6;
);

// --- SCANLINES ---
gfx_set(0, 0, 0, 0.2);
sl = 0;
loop(gfx_h / 4,
  gfx_rect(0, sl, gfx_w, 2);
  sl += 4;
);

// --- SPECTRUM ---
gfx_set(0.22, 1, 0.08, 0.8); // Vostok Green #39FF14
min_db = slider1 - 100;
max_db = slider2;

x_scale = gfx_w / (FFT_SIZE / 2);
last_x = 0;
last_y = gfx_h;

i = 0;
loop(FFT_SIZE / 2,
  freq = i * srate / FFT_SIZE;
  freq > 20 && freq < 20000 ? (
    // Log mapping
    x = gfx_w * (log(freq/20) / log(20000/20));
    
    val = magnitudes[i];
    y = gfx_h - (val - min_db) / (max_db - min_db) * gfx_h;
    
    gfx_line(last_x, last_y, x, y);
    
    // Fill area with gradient-like vertical lines
    gfx_set(0.22, 1, 0.08, 0.2);
    gfx_line(x, y, x, gfx_h);
    gfx_set(0.22, 1, 0.08, 0.8);
    
    last_x = x;
    last_y = y;
  );
  i += 1;
);

// --- HUD ---
gfx_set(1, 1, 1, 0.8);
gfx_setfont(1, "JetBrains Mono", 16);
gfx_x = 20; gfx_y = 20;
gfx_drawstr("VOSTOK SPECTRUM [HD-RTA]");

gfx_set(0.22, 1, 0.08, 1);
gfx_x = 20; gfx_y = 40;
gfx_drawstr("STATUS: OPERATIONAL");

// Calibration info
gfx_set(0.5, 0.5, 0.5, 1);
gfx_setfont(1, "Inter", 12);
gfx_x = gfx_w - 150; gfx_y = gfx_h - 30;
gfx_drawstr("4096 FFT | ISO 1996");
